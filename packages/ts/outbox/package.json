{
  "name": "@drakkar.software/starfish-outbox",
  "version": "3.0.0-alpha.44",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/outbox"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Starfish durable offline write-queue \u2014 dedup-by-id, claim, retry/backoff, reconnect-drain, persisted per identity, framework-free",
