{
  "name": "@drakkar.software/starfish-identities",
  "version": "3.0.0-alpha.29",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/identities"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Starfish root + device identity extension (passphrase derivation, device cap-cert minting, pairing flows, device directory)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@drakkar.software/starfish-protocol": "workspace:*",
    "@drakkar.software/starfish-client": "workspace:*",
    "@drakkar.software/starfish-keyring": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.0",
    "hash-wasm": "^4.12.0"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ]
}
