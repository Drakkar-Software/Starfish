{
  "name": "@drakkar.software/starfish-replica",
  "version": "3.0.0-alpha.72",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/replica"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Starfish replication extension (primary→replica sync, write modes, on-pull/scheduled triggers, push proxy) as a server plugin",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./space": {
      "types": "./dist/space/index.d.ts",
      "import": "./dist/space/index.js"
    }
  },
  "dependencies": {
    "@drakkar.software/starfish-identities": "workspace:*",
    "@drakkar.software/starfish-protocol": "workspace:*",
    "@drakkar.software/starfish-server": "workspace:*"
  },
  "peerDependencies": {
    "@drakkar.software/starfish-client": "workspace:*",
    "@drakkar.software/starfish-keyring": "workspace:*",
    "@drakkar.software/starfish-spaces": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@drakkar.software/starfish-client": { "optional": true },
    "@drakkar.software/starfish-keyring": { "optional": true },
    "@drakkar.software/starfish-spaces": { "optional": true }
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@drakkar.software/starfish-client": "workspace:*",
    "@drakkar.software/starfish-keyring": "workspace:*",
    "@drakkar.software/starfish-spaces": "workspace:*",
    "@noble/curves": "^2.2.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ]
}
