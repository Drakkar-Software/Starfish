{
  "name": "@drakkar.software/starfish-events",
  "version": "3.0.0-alpha.69",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/events"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Starfish server plugin that accepts JSON event batches and encodes them as Parquet on S3",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@drakkar.software/starfish-protocol": "workspace:*",
    "@drakkar.software/starfish-server": "workspace:*",
    "hyparquet-writer": "^0.16.1"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "hyparquet": "1.26.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ]
}
