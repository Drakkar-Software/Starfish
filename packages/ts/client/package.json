{
  "name": "@drakkar.software/starfish-client",
  "version": "3.0.0-alpha.48",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "TypeScript client SDK for the Starfish sync protocol",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zustand": {
      "types": "./dist/bindings/zustand.d.ts",
      "import": "./dist/bindings/zustand.js"
    },
    "./legend": {
      "types": "./dist/bindings/legend.d.ts",
      "import": "./dist/bindings/legend.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast.d.ts",
      "import": "./dist/broadcast.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./suspense": {
      "types": "./dist/bindings/suspense.d.ts",
      "import": "./dist/bindings/suspense.js"
    }
  },
  "peerDependencies": {
    "@legendapp/state": ">=2.0.0",
    "immer": ">=9.0.0",
    "react": ">=18.0.0",
    "zustand": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "zustand": {
      "optional": true
    },
    "immer": {
      "optional": true
    },
    "@legendapp/state": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@drakkar.software/starfish-protocol": "workspace:*"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@legendapp/state": "^2.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "hono": "^4.12.7",
    "immer": "^11.1.4",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6",
    "zustand": "^5.0.11"
  },
  "files": [
    "dist"
  ]
}
