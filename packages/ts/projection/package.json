{
  "name": "@drakkar.software/starfish-projection",
  "version": "3.0.0-alpha.24",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/projection"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Starfish incremental-list extension (post-push projection hook: fold each write into a single list document — append, update-in-place, or remove)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@drakkar.software/starfish-protocol": "workspace:*",
    "@drakkar.software/starfish-server": "workspace:*"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ]
}
