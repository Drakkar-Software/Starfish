{
  "name": "@drakkar.software/starfish-server",
  "version": "1.12.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "TypeScript server for the Starfish sync protocol (Hono / Cloudflare Workers compatible)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/storage/filesystem.d.ts",
      "import": "./dist/storage/filesystem.js"
    },
    "./s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    }
  },
  "dependencies": {
    "@drakkar.software/starfish-protocol": "workspace:*",
    "hono": "^4.12.7"
  },
  "peerDependencies": {
    "ajv": ">=8.0.0",
    "@aws-sdk/client-s3": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@types/node": "^25.5.2",
    "ajv": "^8.17.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ]
}
