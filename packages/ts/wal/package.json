{
  "name": "@drakkar.software/starfish-wal",
  "version": "3.0.0-alpha.22",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/starfish.git",
    "directory": "packages/ts/wal"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Starfish WAL extension — append-only CRDT op-log document model (LWW register + RGA list + text) with trusted snapshots, for encryption \"none\" and \"delegated\"",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@drakkar.software/starfish-protocol": "workspace:*"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "pnpm --filter @drakkar.software/starfish-protocol build && node build.mjs && node tests/bench.mjs"
  },
  "devDependencies": {
    "@noble/curves": "^2.2.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist"
  ]
}
