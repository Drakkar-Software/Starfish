[starfish_servers]
# Replace with your actual server IP or hostname.
# Add ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa as needed.
192.0.2.10 ansible_user=ubuntu

# Multiple servers:
# 192.0.2.11 ansible_user=ubuntu
# 192.0.2.12 ansible_user=ubuntu

[starfish_servers:vars]
ansible_python_interpreter=/usr/bin/python3
