/**
 * Starfish sync server — TypeScript / Hono / Node.js.
 * Generated by Ansible. Edit {{ starfish_app_dir }}/config.json to change collections.
 */
import { readFileSync } from "node:fs"
import { serve } from "@hono/node-server"
import { Hono } from "hono"
import type { Context } from "hono"
import {
  createSyncRouter,
  parseConfigJson,
  saveConfig,
  type AuthResult,
} from "@drakkar.software/starfish-server"
import { FilesystemObjectStore } from "@drakkar.software/starfish-server/node"

const store = new FilesystemObjectStore({ baseDir: "{{ starfish_data_dir }}" })
const config = parseConfigJson(readFileSync("{{ starfish_app_dir }}/config.json", "utf-8"))

/**
 * Resolve identity and roles from the Authorization header.
 * Replace this with your real auth logic (JWT verification, API-key lookup, etc.).
 */
async function roleResolver(c: Context): Promise<AuthResult> {
  const token = c.req.header("authorization") ?? ""
  if (token.startsWith("Bearer ")) {
    const userId = token.slice("Bearer ".length)
    return { identity: userId, roles: ["user"] }
  }
  return { identity: "anonymous", roles: ["public"] }
}

const syncRouter = createSyncRouter({
  store,
  config,
  roleResolver,
  encryptionSecret: process.env.ENCRYPTION_SECRET ?? "change-me",
})

await saveConfig(store, config)

const app = new Hono()
app.route("{{ starfish_api_prefix }}", syncRouter)

serve({ fetch: app.fetch, port: {{ starfish_port }} }, (info) => {
  console.log(`Starfish server listening on http://localhost:${info.port}`)
})
